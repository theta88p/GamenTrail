<Window x:Class="GamenTrail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/GamenTrail.ico" Title="GamenTrail" Width="1000" Height="1040" MinWidth="820" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#131A22" Foreground="#F4F7FB"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="16" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#131A22" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#171E27" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1C242F" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#232C37" />
        <SolidColorBrush x:Key="InputBrush" Color="#1A222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#35404B" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#B1BBC8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7C8793" />
        <SolidColorBrush x:Key="AccentBrush" Color="#86D5B1" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#09251D" />

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#263548" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24443D" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <TextBlock Margin="0,0,12,1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SubtleBrush}"
                                               FontSize="16"
                                               Text="⌄" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Margin="0,3,0,0"
                                            Padding="2"
                                            Background="{StaticResource PanelRaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#90E8C1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepNavigationButton" TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepButtonBorder" Property="Background" Value="#182334" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StepButtonBorder" Property="Background" Value="#1D2A3A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StepButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="CheckBorder" Width="18" Height="18" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CheckMark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}" Text="&#xE73E;" Visibility="Collapsed" HorizontalAlignment="Center" />
                    </Border>
                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="StepExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="#303A45" BorderThickness="1" CornerRadius="9">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="9" Padding="22,14">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        <TextBlock x:Name="Chevron" Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE70D;" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" /></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelRaisedBrush}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="StepContent" Visibility="Collapsed" ContentSource="Content" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="StepContent" Property="Visibility" Value="Visible" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsExpanded" Value="True" /><Condition Property="Tag" Value="Capture" /></MultiTrigger.Conditions><Setter TargetName="HeaderToggle" Property="Visibility" Value="Collapsed" /></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" Background="#4A5663" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeTile" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Tile" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,8">
                    <ContentPresenter HorizontalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Tile" Property="BorderThickness" Value="2" /><Setter TargetName="Tile" Property="Padding" Value="7,7" /><Setter TargetName="Tile" Property="Background" Value="{StaticResource PanelRaisedBrush}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="Background" Value="#30443F" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="44,16,44,15" Background="{StaticResource HeaderBrush}">
            <StackPanel><TextBlock FontSize="34" FontWeight="Bold" Text="GamenTrail" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource SubtleBrush}" Text="画面の足跡を、そのまま残す。" /></StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="15,0" Height="58">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="CaptureStepButton" Grid.Column="0" HorizontalContentAlignment="Center" Click="ShowCaptureSettings_Click" Style="{StaticResource StepNavigationButton}" AutomationProperties.Name="録画対象を開く">
                <StackPanel Orientation="Horizontal"><Border x:Name="CaptureStepBadge" Width="34" Height="34" CornerRadius="17" BorderThickness="1"><TextBlock x:Name="CaptureStepNumber" FontSize="20" HorizontalAlignment="Center" Text="1" /></Border><TextBlock x:Name="CaptureStepLabel" Margin="10,0,0,0" FontSize="18" Text="録画対象" /></StackPanel>
            </Button>
            <Button x:Name="QualityStepButton" Grid.Column="1" HorizontalContentAlignment="Center" Click="ShowAdvancedSettings_Click" Style="{StaticResource StepNavigationButton}" AutomationProperties.Name="音声とコーデックを開く">
                <StackPanel Orientation="Horizontal"><Border x:Name="QualityStepBadge" Width="34" Height="34" CornerRadius="17" BorderThickness="1"><TextBlock x:Name="QualityStepNumber" FontSize="20" HorizontalAlignment="Center" Text="2" /></Border><TextBlock x:Name="QualityStepLabel" Margin="10,0,0,0" FontSize="18" Text="音声とコーデック" /></StackPanel>
            </Button>
            <Button x:Name="SaveStepButton" Grid.Column="2" HorizontalContentAlignment="Center" Click="ShowSaveSettings_Click" Style="{StaticResource StepNavigationButton}" AutomationProperties.Name="保存を開く">
                <StackPanel Orientation="Horizontal"><Border x:Name="SaveStepBadge" Width="34" Height="34" CornerRadius="17" BorderThickness="1"><TextBlock x:Name="SaveStepNumber" FontSize="20" HorizontalAlignment="Center" Text="3" /></Border><TextBlock x:Name="SaveStepLabel" Margin="10,0,0,0" FontSize="18" Text="保存" /></StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15,24,15,20" IsEnabled="{Binding IsSettingsEnabled}">
                <Expander x:Name="CaptureExpander" Tag="Capture" IsExpanded="True" Style="{StaticResource StepExpander}">
                    <Expander.Header><Grid><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource SubtleBrush}" BorderThickness="1"><TextBlock FontSize="20" HorizontalAlignment="Center" Text="1" /></Border><TextBlock Margin="12,0,0,0" FontSize="18" FontWeight="SemiBold" Text="録画対象" /></StackPanel><TextBlock x:Name="CaptureStepStatus" Visibility="Collapsed" /></Grid></Expander.Header>
                    <StackPanel Margin="26,20,26,18">
                        <TextBlock FontSize="20" FontWeight="Bold" Text="録画する対象を選択してください" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="キャプチャ モード" />
                                <ListBox ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding SelectedCaptureMode}" ItemContainerStyle="{StaticResource ModeTile}" BorderThickness="0" Background="Transparent" Foreground="#F4F7FB" Padding="0" Margin="0,3,-10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="キャプチャモード">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                <ScrollViewer Focusable="False" CanContentScroll="True">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Margin="0,0,0,5">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE7F4;" /><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Window"><Setter Property="Text" Value="&#xE737;" /></DataTrigger><DataTrigger Binding="{Binding Mode}" Value="Region"><Setter Property="Text" Value="&#xEF20;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="画面" /><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Window"><Setter Property="Text" Value="ウィンドウ" /></DataTrigger><DataTrigger Binding="{Binding Mode}" Value="Region"><Setter Property="Text" Value="範囲" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="0,10,0,6" Style="{StaticResource FieldLabel}" Text="対象" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Targets}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTarget}" AutomationProperties.Name="録画対象" />
                                    <Button Grid.Column="1" Padding="0" Margin="5,0,0,0" Command="{Binding RefreshTargetsCommand}" ToolTip="対象を再読込" AutomationProperties.Name="対象を再読込"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" /></Button>
                                </Grid>
                                <TextBlock Margin="0,6,0,10" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="選択した画面全体を録画します。" /><Style.Triggers><DataTrigger Binding="{Binding IsWindowMode}" Value="True"><Setter Property="Text" Value="選択したウィンドウを録画します。" /></DataTrigger><DataTrigger Binding="{Binding IsRegionMode}" Value="True"><Setter Property="Text" Value="指定した画面上の範囲を録画します。" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button Height="48" Click="PickTarget_Click" IsEnabled="{Binding IsVisualPickerEnabled}" Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Margin="0,0,16,0" Text="&#xE7F4;" /><TextBlock FontSize="19" Text="画面から選択" /></StackPanel>
                                </Button>
                            <Grid Margin="0,16,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegionMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="X" /><TextBox Text="{Binding RegionX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Y" /><TextBox Text="{Binding RegionY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="幅" /><TextBox Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource FieldLabel}" Text="高さ" /><TextBox Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </Grid>
                            <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" Text="{Binding RegionHint}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegionMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>

                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsWindowMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="サイズ（px）" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ウィンドウの幅（px）" />
                                    <TextBlock Grid.Column="1" Margin="10,0" Text="×" />
                                    <TextBox Grid.Column="2" Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ウィンドウの高さ（px）" />
                                    <Button Grid.Column="3" Margin="12,0,0,0" Command="{Binding ResizeWindowCommand}" Content="適用" />
                                </Grid>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding CaptureOverlappingWindows}" Content="手前に重なるウィンドウも録画する" />
                            </StackPanel>

                            </StackPanel>
                            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="対象のプレビュー" />
                                <Border Grid.Row="1" Margin="0,10,0,0" MinHeight="200" Background="#10151B" BorderBrush="#52585E" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                    <Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" Text="対象を選択するとプレビューを表示します" FontSize="13" TextWrapping="Wrap" Margin="20">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock><Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="選択したキャプチャ範囲のライブ映像" /></Grid>
                                </Border>
                                <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12" Foreground="{StaticResource SubtleBrush}" Text="{Binding PreviewStatus}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Height="32" Padding="8,2" Command="{Binding RefreshPreviewCommand}" Content="更新" AutomationProperties.Name="ライブプレビューに再接続" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <CheckBox Margin="0,0,22,4" IsChecked="{Binding IncludeCursor}" Content="マウスカーソルを含める" />
                            <CheckBox Margin="0,0,22,4" IsChecked="{Binding ShowCaptureBorder}" Content="キャプチャ枠を表示" />
                            <CheckBox Margin="0,0,0,4" IsChecked="{Binding DisableWindowCornerRounding}" IsEnabled="{Binding IsWindowMode}" Content="角丸を解除" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
                <Expander x:Name="QualityExpander" Margin="0,16,0,0" Style="{StaticResource StepExpander}">
                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource SubtleBrush}" BorderThickness="1"><TextBlock FontSize="20" HorizontalAlignment="Center" Text="2" /></Border><TextBlock Margin="12,0,0,0" FontSize="18" FontWeight="SemiBold" Text="音声とコーデック" /></StackPanel>
                        <TextBlock Grid.Column="1" Margin="20,0" TextAlignment="Right" FontSize="14" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedCodec.DisplayName, TargetNullValue=映像コーデック未選択, FallbackValue=映像コーデック未選択}" /><Run Text=" · " /><Run Text="{Binding SelectedFrameRate.DisplayName}" /></TextBlock><TextBlock x:Name="QualityStepStatus" Visibility="Collapsed" />
                    </Grid></Expander.Header>
                    <Border Padding="22" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="録音方法" />
                                    <ComboBox x:Name="AudioModeSelector" ItemsSource="{Binding AudioModes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAudioMode}" AutomationProperties.Name="録音方法" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AudioSourceLabel}" />
                                    <ComboBox x:Name="AudioSourceSelector" ItemsSource="{Binding AudioSources}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsAudioSourceEnabled}" SelectedItem="{Binding SelectedAudioSource}" AutomationProperties.Name="音声の対象" ToolTip="{Binding SelectedAudioSource.DisplayName}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="映像コーデック" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" Content="設定..." Click="ConfigureCodec_Click" IsEnabled="{Binding CanConfigureCodec}" AutomationProperties.Name="映像コーデックの設定" ToolTip="選択したコーデックの設定画面を開きます。設定画面がないコーデックでは使用できません。" />
                                        <ComboBox ItemsSource="{Binding Codecs}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedCodec}" AutomationProperties.Name="映像コーデック" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="フレームレート" />
                                    <ComboBox ItemsSource="{Binding FrameRates}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedFrameRate}" AutomationProperties.Name="フレームレート" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0" IsEnabled="{Binding IsAudioSettingsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="音声コーデック" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" Content="設定..." Click="ConfigureAudioCodec_Click" IsEnabled="{Binding CanConfigureAudioCodec}" AutomationProperties.Name="音声コーデックの設定" ToolTip="選択した音声コーデックの形式や品質を設定します。" />
                                        <ComboBox x:Name="AudioCodecSelector" ItemsSource="{Binding AudioCodecs}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAudioCodec}" AutomationProperties.Name="音声コーデック" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="サンプリングレート" />
                                    <ComboBox ItemsSource="{Binding AudioSampleRates}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAudioSampleRate}" AutomationProperties.Name="サンプリング" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>
                <Expander x:Name="SaveExpander" Margin="0,16,0,0" Style="{StaticResource StepExpander}">
                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource SubtleBrush}" BorderThickness="1"><TextBlock FontSize="20" HorizontalAlignment="Center" Text="3" /></Border><TextBlock Margin="12,0,0,0" FontSize="18" FontWeight="SemiBold" Text="保存" /></StackPanel>
                        <TextBlock Grid.Column="1" Margin="20,0" TextAlignment="Right" FontSize="14" Foreground="{StaticResource SubtleBrush}" Text="{Binding OutputFolder, StringFormat=保存先: {0}}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SaveStepStatus" Visibility="Collapsed" />
                    </Grid></Expander.Header>
                    <Border Padding="22" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="保存形式" /><ComboBox ItemsSource="{Binding ContainerFormats}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedContainerFormat}" /></StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="保存フォルダー" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Command="{Binding BrowseFolderCommand}" Content="参照..." />
                                </Grid>
                                <TextBlock Margin="0,7,0,0" Foreground="{StaticResource SubtleBrush}" FontSize="12" Text="{Binding OutputFileHint}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Padding="32,26" Background="#0D151E" BorderBrush="#4A535B" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /><ColumnDefinition Width="24" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource AccentBrush}" Text="&#xE930;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FB" /><Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="Error"><Setter Property="Foreground" Value="#FF7C8A" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="14" Foreground="{StaticResource SubtleBrush}" Text="設定はいつでも変更できます。" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"><Run Text="{Binding ElapsedText}" /><Run Text="  ·  ファイルサイズ " /><Run Text="{Binding FileSizeText}" /><Run Text="  ·  空き容量 " /><Run Text="{Binding FreeSpaceText}" /></TextBlock>
                    </StackPanel>
                </Grid>
                <Button Grid.Column="1" Height="54" Click="OpenAdvancedSettings_Click" IsEnabled="{Binding IsSettingsEnabled}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Margin="0,0,12,0" Text="&#xE713;" /><TextBlock Text="詳細設定" /></StackPanel></Button>
                <Button Grid.Column="3" Height="54" Command="{Binding ToggleRecordingCommand}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Background" Value="#FF7283" /><Setter Property="BorderBrush" Value="#FF7283" /><Setter Property="Foreground" Value="#26060B" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Margin="0,0,14,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE7C8;" /><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Text" Value="&#xE71A;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock FontSize="19" Text="{Binding RecordButtonText}" /></StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
